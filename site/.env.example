# Public (safe to expose) --------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_GA_MEASUREMENT_ID=            # G-XXXXXXX; analytics loads only after consent (F5)

# Build behaviour -----------------------------------------------------------
# ASTER_ENV=production                      # when set, placeholders are omitted and BLOCK fields must be set
# ALLOW_INDEXING=false                      # robots: staging stays noindex unless explicitly true

# Inquiries pipeline (server only) -----------------------------------------
CRM_PROVIDER=mock                           # mock (dev) | none (live site, no CRM yet) | hubspot
# HUBSPOT_PORTAL_ID=
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_FORM_GUID_QUOTE=
# HUBSPOT_FORM_GUID_TECHNICAL=
EMAIL_PROVIDER=console                      # console (dev) | resend | smtp
# RESEND_API_KEY=                           # resend: API key; EMAIL_FROM must be on a domain verified in Resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Aster Industrial Coatings <no-reply@example.com>"
# SALES_NOTIFICATION_EMAIL=                 # E1
# TECHNICAL_NOTIFICATION_EMAIL=             # E2
# ADMIN_ALERT_EMAIL=
LEAD_STORE=jsonl                            # jsonl (dev / single server) | none (serverless: email is the record) — add a database later
LEAD_STORE_PATH=./data/leads.jsonl
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_PER_IP=5
MIN_SECONDS_TO_SUBMIT=3
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
